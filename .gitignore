__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env


# Generated videos stay out: ~1 GB, and every one is reproducible in seconds.
output/

# Whisper model cache
~/.cache/whisper/

# Runtime log
app.log

# Word clip cache
corpora/*/cache/
cache/

# Packed bundles are artefacts -- useful for moving a corpus to a server or
# keeping a backup, but the repo carries the loose corpus instead.
corpus/

# Source packs are large binaries; the directory is tracked, its contents are not.
packs/*
!packs/README.md

# Cached YouTube captions, fetched by scripts/verify_corpus.py.
# Derived, re-fetchable, and someone else's text -- not ours to keep
# in git or to ship inside a corpus bundle.
corpora/*/captions/

# Corpora, every one of them. The shipped voice is published as a bundle on
# the `corpus` release, packed by hand from a corpus that has been checked;
# the repo carries no copy of it. A loose copy in git was a second, unreviewed
# version of the same data -- one ingest or refine away from differing from
# the release, and over a hundred megabytes of video in history for each
# change to it. Ignored rather than merely untracked, because `git add -A`
# during an ingest will otherwise put a half-downloaded 3 GB corpus into
# history forever.
/corpora/

# Scratch audio, if an older version of the scripts is still around or a
# run is killed before it tidies up. These are tens of megabytes each.
_rb_*.wav
_nz_*.wav
_fa_*.wav

# Corpus bundles. `pack` writes to the working directory by default, so one
# lands in the checkout after every build. These were matched only as
# corpus-*.tar.zst, which is the default date-stamped name -- a bundle named
# after its corpus, which is what build_corpus makes, went straight past it
# and sat there at 1.8 GB.
*.tar.zst
*.tar.gz

# The global pronunciation dictionary. The repo root doubles as the default
# data directory, so this is somebody's own word list, not part of the
# project. The per-corpus ones belong to the voice and travel in its bundle.
/pronunciations.csv

# The Matrix bot's saved login when run outside Docker (the repo root is the
# default data directory). It holds an access token.
/matrix/
# YTPMV uploads and word measurements, same reason: runtime data.
/ytpmv/

# Recoverable overwrites and incomplete staged corpus restores.
.corpus-backups/
.install-*/
.unpack-*/
.audit-work/
