__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# The corpus is committed: the database and the source videos it indexes, so a
# clone is a working install. Not as a single tarball -- that comes to 103 MB
# and GitHub refuses any file over 100 MB. As 49 loose files none of which
# exceeds 9 MB, it goes in fine.
#
# SQLite's sidecar files are per-corpus and are pure runtime state; the
# checkpointed .db beside them holds everything they do.
corpora/*/*.db-wal
corpora/*/*.db-shm

# Generated videos stay out: ~1 GB, and every one is reproducible in seconds.
output/

# Whisper model cache
~/.cache/whisper/

# Runtime log
app.log

# Packed bundles are artefacts -- useful for moving a corpus to a server or
# keeping a backup, but the repo carries the loose corpus instead.
corpus/
corpus-*.tar.zst
corpus-*.tar.gz

# Source packs are large binaries; the directory is tracked, its contents are not.
packs/*
!packs/README.md

# Cached YouTube captions, fetched by scripts/verify_corpus.py.
# Derived, re-fetchable, and someone else's text -- not ours to keep
# in git or to ship inside a corpus bundle.
corpora/*/captions/

# Corpora you build locally. Only the shipped Michael Rosen corpus is in
# git -- as loose files, because the bundle exceeds GitHub's 100 MB limit.
# Everything else is derived data: gigabytes of binary that never
# delta-compresses and can be rebuilt from a channel link. Ignored rather
# than merely untracked, because `git add -A` during an ingest will
# otherwise put a half-downloaded 3 GB corpus into history forever.
/corpora/*
!/corpora/michael-rosen/

# Scratch audio, if an older version of the scripts is still around or a
# run is killed before it tidies up. These are tens of megabytes each.
_rb_*.wav
_nz_*.wav
_fa_*.wav
